{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @mandio/backend build",
    "watchPatterns": [
      "/apps/backend/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.npmrc",
      "/.nvmrc"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @mandio/backend db:migrate:prod",
    "startCommand": "pnpm --filter @mandio/backend start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
