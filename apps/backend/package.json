{
  "name": "@mandio/backend",
  "version": "0.0.1",
  "description": "Backend Medusa v2 de Mandi'o",
  "author": "Mandi'o",
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "cd .medusa/server && medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "db:setup": "medusa db:setup --db mandio",
    "db:migrate": "medusa db:migrate",
    "db:migrate:prod": "cd .medusa/server && medusa db:migrate",
    "user:admin": "medusa user -e admin@mandio.com.py -p mandio1234",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "reindex": "medusa exec ./src/scripts/reindex.ts",
    "seed:demo": "medusa exec ./src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/ui": "4.3.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.23.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
