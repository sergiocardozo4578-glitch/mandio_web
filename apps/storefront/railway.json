{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @mandio/storefront build",
    "watchPatterns": [
      "/apps/storefront/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.npmrc",
      "/.nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @mandio/storefront exec next start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
